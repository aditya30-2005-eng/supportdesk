# Copy this file to .env and fill in your own values. Never commit .env.

DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Matches the database in docker-compose.yml (host port 5433 avoids clashing with a local PostgreSQL)
DATABASE_URL=postgres://supportdesk:supportdesk@localhost:5433/supportdesk

CELERY_BROKER_URL=redis://localhost:6379/0
# Set to True to run tasks inline when Redis is not available
CELERY_TASK_ALWAYS_EAGER=False

CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# In development, emails are printed in the terminal that sends them
# (the Celery worker, or runserver when CELERY_TASK_ALWAYS_EAGER=True).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=SupportDesk <no-reply@supportdesk.local>

# For Mailtrap or Gmail, switch to the SMTP backend and fill these in.
# Mailtrap host: sandbox.smtp.mailtrap.io  Gmail host: smtp.gmail.com (use an app password)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=sandbox.smtp.mailtrap.io
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-username
# EMAIL_HOST_PASSWORD=your-password
# EMAIL_USE_TLS=True
